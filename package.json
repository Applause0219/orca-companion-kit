{
  "name": "orca-companion-kit",
  "version": "0.1.0",
  "description": "Build your own Orca IDE theme, desktop companion pet and custom cursor with an AI agent. Injected over a private CDP pipe; Orca's install is never modified, so it survives updates.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/themer.mjs",
    "example": "node tools/example.mjs",
    "check": "node tools/check.mjs",
    "cursor": "node tools/cursor-css.mjs",
    "chime": "node tools/make-chime.mjs",
    "guard": "node tools/guard.mjs",
    "bot": "node src/bot/bot.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "perf": "node tools/perf.mjs",
    "live-check": "node tools/live-check.mjs"
  },
  "dependencies": {
    "@electron/asar": "3.2.17"
  },
  "optionalDependencies": {
    "playwright-core": "1.64.1"
  }
}
